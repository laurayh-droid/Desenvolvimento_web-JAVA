{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Imepac - Order System",
    "description": "Collection completa para o sistema de pedidos Imepac. Contém todos os endpoints do customer-service (porta 8081) e order-service (porta 8082).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "customer_base_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "order_base_url",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Customer Service",
      "description": "Endpoints do customer-service rodando na porta 8081",
      "item": [
        {
          "name": "Criar Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.id) {",
                  "        pm.collectionVariables.set('customer_id', body.data.id);",
                  "        console.log('customer_id salvo: ' + body.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao.silva@email.com\",\n  \"phone\": \"(11) 91234-5678\"\n}"
            },
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers"]
            },
            "description": "Cria um novo cliente. O ID retornado é salvo automaticamente na variável `customer_id`."
          },
          "response": []
        },
        {
          "name": "Buscar Cliente por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers/{{customer_id}}",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers", "{{customer_id}}"]
            },
            "description": "Busca um cliente pelo ID. Usa a variável `customer_id`."
          },
          "response": []
        },
        {
          "name": "Listar Todos os Clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers"]
            },
            "description": "Retorna todos os clientes (ativos e inativos)."
          },
          "response": []
        },
        {
          "name": "Listar Apenas Clientes Ativos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers?activeOnly=true",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers"],
              "query": [
                {
                  "key": "activeOnly",
                  "value": "true"
                }
              ]
            },
            "description": "Retorna apenas os clientes com status ativo."
          },
          "response": []
        },
        {
          "name": "Atualizar Cliente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva Atualizado\",\n  \"phone\": \"(11) 99876-5432\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers/{{customer_id}}",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers", "{{customer_id}}"]
            },
            "description": "Atualiza dados de um cliente existente. Todos os campos são opcionais."
          },
          "response": []
        },
        {
          "name": "Desativar Cliente (active: false)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers/{{customer_id}}",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers", "{{customer_id}}"]
            },
            "description": "Desativa um cliente sem removê-lo da base."
          },
          "response": []
        },
        {
          "name": "Deletar Cliente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers/{{customer_id}}",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers", "{{customer_id}}"]
            },
            "description": "Remove um cliente. Retorna 204 No Content em caso de sucesso."
          },
          "response": []
        },
        {
          "name": "Validar Cliente Ativo (uso interno)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers/{{customer_id}}/validate-active",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers", "{{customer_id}}", "validate-active"]
            },
            "description": "Endpoint consumido pelo order-service via Feign para validar se o cliente está ativo antes de criar um pedido."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Order Service",
      "description": "Endpoints do order-service rodando na porta 8082",
      "item": [
        {
          "name": "Criar Pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.id) {",
                  "        pm.collectionVariables.set('order_id', body.data.id);",
                  "        console.log('order_id salvo: ' + body.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customer_id}},\n  \"items\": [\n    {\n      \"productName\": \"Notebook Dell Inspiron 15\",\n      \"quantity\": 1,\n      \"unitPrice\": 3499.90\n    },\n    {\n      \"productName\": \"Mouse Logitech MX Master 3\",\n      \"quantity\": 2,\n      \"unitPrice\": 349.99\n    },\n    {\n      \"productName\": \"Teclado Mecânico Redragon\",\n      \"quantity\": 1,\n      \"unitPrice\": 289.90\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Cria um novo pedido para o cliente definido em `customer_id`. O order-service valida o cliente via Feign antes de persistir. O ID do pedido criado é salvo na variável `order_id`."
          },
          "response": []
        },
        {
          "name": "Criar Pedido (item único)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.id) {",
                  "        pm.collectionVariables.set('order_id', body.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customer_id}},\n  \"items\": [\n    {\n      \"productName\": \"Monitor LG UltraWide 29\",\n      \"quantity\": 1,\n      \"unitPrice\": 1899.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Cria um pedido com apenas um item."
          },
          "response": []
        },
        {
          "name": "Buscar Pedido por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders/{{order_id}}",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders", "{{order_id}}"]
            },
            "description": "Busca um pedido pelo ID. Usa a variável `order_id`."
          },
          "response": []
        },
        {
          "name": "Listar Todos os Pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Retorna todos os pedidos cadastrados."
          },
          "response": []
        },
        {
          "name": "Listar Pedidos por Cliente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders/customer/{{customer_id}}",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders", "customer", "{{customer_id}}"]
            },
            "description": "Retorna todos os pedidos de um cliente específico."
          },
          "response": []
        },
        {
          "name": "Atualizar Status → CONFIRMED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders/{{order_id}}/status",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders", "{{order_id}}", "status"]
            },
            "description": "Confirma o pedido. Status disponíveis: PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED."
          },
          "response": []
        },
        {
          "name": "Atualizar Status → PROCESSING",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PROCESSING\"\n}"
            },
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders/{{order_id}}/status",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders", "{{order_id}}", "status"]
            },
            "description": "Coloca o pedido em processamento."
          },
          "response": []
        },
        {
          "name": "Atualizar Status → SHIPPED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\"\n}"
            },
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders/{{order_id}}/status",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders", "{{order_id}}", "status"]
            },
            "description": "Marca o pedido como despachado."
          },
          "response": []
        },
        {
          "name": "Atualizar Status → DELIVERED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\"\n}"
            },
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders/{{order_id}}/status",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders", "{{order_id}}", "status"]
            },
            "description": "Marca o pedido como entregue."
          },
          "response": []
        },
        {
          "name": "Atualizar Status → CANCELLED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}"
            },
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders/{{order_id}}/status",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders", "{{order_id}}", "status"]
            },
            "description": "Cancela o pedido."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cenários de Erro",
      "description": "Requisições para testar respostas de erro da API",
      "item": [
        {
          "name": "[400] Criar Cliente - Email inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria\",\n  \"email\": \"email-invalido\",\n  \"phone\": \"(21) 98888-7777\"\n}"
            },
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers"]
            },
            "description": "Deve retornar 400 Bad Request por email inválido."
          },
          "response": []
        },
        {
          "name": "[400] Criar Cliente - Nome ausente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sem.nome@email.com\"\n}"
            },
            "url": {
              "raw": "{{customer_base_url}}/api/v1/customers",
              "host": ["{{customer_base_url}}"],
              "path": ["api", "v1", "customers"]
            },
            "description": "Deve retornar 400 Bad Request pois o campo `name` é obrigatório."
          },
          "response": []
        },
        {
          "name": "[404] Buscar Cliente inexistente",
          "request": {
            "method": "GET",
