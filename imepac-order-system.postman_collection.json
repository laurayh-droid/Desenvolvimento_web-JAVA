              "raw": "{\n  \"customerId\": {{customer_id}},\n  \"items\": []\n}"
            },
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Deve retornar 400 Bad Request pois `items` não pode ser vazio."
          },
          "response": []
        },
        {
          "name": "[400] Criar Pedido - Preço zero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customer_id}},\n  \"items\": [\n    {\n      \"productName\": \"Produto Grátis\",\n      \"quantity\": 1,\n      \"unitPrice\": 0.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{order_base_url}}/api/v1/orders",
              "host": ["{{order_base_url}}"],
              "path": ["api", "v1", "orders"]
            },
